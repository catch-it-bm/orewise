{
  "realm": "orewise",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Orewise operator: manages tenants and plans" },
      { "name": "tenant-admin", "description": "Manages one tenant's collections, sources and widgets" }
    ]
  },
  "groups": [
    {
      "name": "tenants",
      "subGroups": [
        {
          "name": "demo",
          "subGroups": [
            { "name": "hr" }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "orewise-admin",
      "name": "Orewise Admin",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:8081/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "platform-admin",
      "email": "platform-admin@orewise.local",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "realmRoles": ["platform-admin"],
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }]
    },
    {
      "username": "demo-admin",
      "email": "admin@demo.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "realmRoles": ["tenant-admin"],
      "groups": ["/tenants/demo"],
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }]
    },
    {
      "username": "demo-user",
      "email": "user@demo.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "groups": ["/tenants/demo/hr"],
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }]
    }
  ]
}
